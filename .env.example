# Configure the independent serial controller; depends on pyserial and USB access.
# Copy to ignored .env; port=auto requires exactly one /dev/serial/by-id device.
CABEK_LIGHTS_PORT=auto
CABEK_LIGHTS_BAUD=115200
CABEK_LIGHTS_TIMEOUT=1
CABEK_LIGHTS_RECONNECT_SECONDS=2
CABEK_LIGHTS_HEALTH_SECONDS=5
CABEK_LIGHTS_UPDATE_HZ=15
# Optional direct access from a local browser; Vite normally proxies local requests.
CABEK_LIGHTS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
